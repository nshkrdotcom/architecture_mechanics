__pycache__/
*.py[cod]
.venv/
.uv/
.pytest_cache/
.ruff_cache/

# Large or regenerable run artifacts. Manifests, summaries, metrics, claim
# gates, and figures ARE committed — they are the evidence. Checkpoints and
# raw tensors are not.
runs/**/checkpoint/
runs/**/*.pt
runs/**/*.safetensors

# Wall clock, peak VRAM, free VRAM: measurements of this machine at that
# instant, not of the experiment. Committing them would make an identical
# re-run dirty the tree and hide the fact that everything else is
# reproducible. The cost floor these price later rungs against is recorded in
# reports/cost_floor.md.
runs/**/cost.json
data/cache/
wandb/
